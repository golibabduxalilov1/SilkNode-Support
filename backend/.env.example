PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-secret-in-production
BOT_TOKEN=123456:PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
MINIAPP_URL=https://your-domain.uz/app
ADMIN_URL=https://your-domain.uz/admin
# Bot /start bosilganda shu Telegram ID'ga ega foydalanuvchi avtomatik admin sifatida
# tanilib, unga Admin Panel tugmasi ko'rsatiladi (raqam so'ralmaydi). Bo'sh qoldirilsa,
# standart qiymat (6964589225) ishlatiladi.
SUPERADMIN_TELEGRAM_ID=6964589225
# Bo'sh qoldirilsa, CORS avtomatik ravishda faqat MINIAPP_URL va ADMIN_URL
# domenlariga toraytiriladi. Boshqa domenlarga ruxsat kerak bo'lsa, vergul bilan
# ajratib shu yerda ko'rsating (hech qachon "*" ishlatmang).
CORS_ORIGIN=
UPLOAD_DIR=./uploads
# TZ 4.2-band: bitta fayl uchun maksimum hajm (Telegram Bot API cheklovi hisobga olingan).
MAX_FILE_MB=20
# TZ 8-bo'lim: "Hal qilindi" holatida foydalanuvchi javob bermasa, necha kundan so'ng
# tizim murojaatni avtomatik "Yopildi" holatiga o'tkazadi.
AUTO_CLOSE_AFTER_DAYS=3

# PostgreSQL ulanish (DATABASE_URL berilsa, quyidagi PG* qiymatlar e'tiborga olinmaydi)
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=silknode

# Faqat lokal ishlab chiqish uchun! NODE_ENV=production bo'lganda bu=1 bo'lsa,
# server xato bilan ishga tushmaydi (initData tekshiruvini chetlab o'tishga imkon berganligi uchun).
DEV_AUTH_BYPASS=1

# Superadmin — Admin Panelga bazadan mustaqil kirish uchun eng yuqori huquqli akkaunt.
# Bu qiymatlar bazadagi users jadvaliga bog'liq emas, faqat server .env fayli orqali
# boshqariladi. HAQIQIY QIYMATLAR HECH QACHON REPOZITORIYGA COMMIT QILINMASIN.
SUPERADMIN_USERNAME=superadmin
# Parolni oddiy matn holida saqlamang — o'rniga bcrypt hash saqlang. Hash olish uchun:
#   npm run hash-password
# buyrug'ini ishga tushiring, parolni kiriting va chiqqan hash'ni pastga qo'ying.
SUPERADMIN_PASSWORD_HASH=change-this-strong-password
