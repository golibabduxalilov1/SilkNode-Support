{
  "name": "silknode-support-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:miniapp",
    "dev:miniapp": "vite --host --mode miniapp",
    "dev:admin": "vite --host --mode admin",
    "build": "npm run build:miniapp && npm run build:admin",
    "build:miniapp": "vite build --mode miniapp --outDir dist/miniapp",
    "build:admin": "vite build --mode admin --outDir dist/admin",
    "preview:miniapp": "vite preview --host --outDir dist/miniapp --port 5173",
    "preview:admin": "vite preview --host --outDir dist/admin --port 5174"
  },
  "dependencies": {
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.10"
  }
}
