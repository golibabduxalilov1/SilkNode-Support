VITE_API_URL=/api

# Faqat lokal ishlab chiqish uchun! Ilova Telegram tashqarisida (brauzerdan)
# ochilganda ko'rsatiladigan bloklovchi ekranni chetlab o'tadi. Production
# build'da (vite build) bu bypass hech qachon ishlamaydi.
VITE_DEV_AUTH_BYPASS=1

# Bloklovchi ekrandagi "Botni Telegram'da ochish" tugmasi uchun bot username'i
# (@ belgisiz). Bo'sh qoldirilsa, tugma ko'rsatilmaydi.
VITE_TELEGRAM_BOT_USERNAME=
